# ========================================
# 部署环境变量（复制为 .env 后填写）
# ========================================
# 注意：
#   - LLM_API_KEY / AMAP_API_KEY / UNSPLASH_ACCESS_KEY / AMAP_WEB_KEY → 后端使用
#   - VITE_AMAP_WEB_KEY → 前端构建时注入（可与 AMAP_WEB_KEY 相同值）
#   - 高德 Key 在 console.amap.com 创建时需同时勾选"Web服务"和"Web JS API"

# LLM API 配置（推荐 DeepSeek，性价比高）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 高德地图 Web 服务 Key（后端 API 调用用）
AMAP_API_KEY=your-amap-key-here

# Unsplash Access Key（可选，用于景点配图）
UNSPLASH_ACCESS_KEY=your-unsplash-key-here

# 高德地图 Web Key（后端 pydantic-settings 读取，与上面可以是同一个）
AMAP_WEB_KEY=your-amap-key-here

# 高德地图 Web JS Key（前端 Vite 构建时注入）
VITE_AMAP_WEB_KEY=your-amap-js-key-here

# ========================================
# 部署环境变量（复制为 .env 后填写）
# ========================================

# LLM API 配置
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 高德地图 Web 服务 Key
AMAP_API_KEY=your-amap-key-here

# Unsplash Access Key
UNSPLASH_ACCESS_KEY=your-unsplash-key-here

# 高德地图 Web JS Key（用于前端地图展示）
VITE_AMAP_WEB_KEY=your-amap-js-key-here
